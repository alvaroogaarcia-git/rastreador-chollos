FROM python:3.10-slim

WORKDIR /app

# Copiamos primero las dependencias para aprovechar el almacenamiento en caché
COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

# Copiamos el resto del código
COPY . .

EXPOSE 5000

# Arrancamos Uvicorn escuchando en todas las interfaces en el puerto 5000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "5000"]